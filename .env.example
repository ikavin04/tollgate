# PayPal Developer Sandbox REST App Credentials (never commit real secrets)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Local application base URL (must match the host/port used by PayPal return & cancel redirects)
APP_BASE_URL=http://localhost:3000

# Google Gemini API Configuration (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional SQLite database path override (defaults to ./data/tollgate.db when blank)
DATABASE_PATH=
